	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.3",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"svelte": "^5.56.3",
		"svelte-check": "^4.3.5",
		"typescript": "^5.9.3",
		"vite": "^7.3.2"
	},
	"dependencies": {
		"marked": "^17.0.1"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"devalue": "^6.0.2",
		"source-map-js": "^1.2.2"
	}
}
