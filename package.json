{
	"name": "vendor-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:azure": "npm run build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
