# Procore OAuth
PROCORE_ENV=production
PROCORE_CLIENT_ID=your-procore-client-id
PROCORE_CLIENT_SECRET=your-procore-client-secret
PROCORE_OAUTH_SCOPES=
# Leave unset in production to auto-use the current origin callback URL.
# Set explicitly only if Procore requires an exact callback URL.
# PROCORE_REDIRECT_URI=https://your-cloud-run-domain/api/procore/oauth/callback

# Vendor database (optional)
VENDOR_DB_ENABLED=false
VENDOR_DB_LIMIT=200

# Option 1: direct connection string
# VENDOR_DB_CONNECTION_URL=postgresql://user:pass@host:5432/dbname

# Option 2: Cloud SQL connector
# VENDOR_DB_INSTANCE_CONNECTION_NAME=project:region:instance
# VENDOR_DB_USER=postgres
# VENDOR_DB_PASS=change-me
# VENDOR_DB_NAME=postgres
# VENDOR_DB_IP_TYPE=PUBLIC
